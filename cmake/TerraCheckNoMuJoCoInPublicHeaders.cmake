# 用法：cmake -DSOURCE_DIR=<仓库根目录> -P TerraCheckNoMuJoCoInPublicHeaders.cmake
# 检查 Terra 公共头（engine/ 下任意 include/ 目录）与应用（apps/）中没有包含 MuJoCo 头文件（D-009）。
if(NOT DEFINED SOURCE_DIR)
    message(FATAL_ERROR "需要 -DSOURCE_DIR")
endif()

file(GLOB_RECURSE engine_files "${SOURCE_DIR}/engine/*")
file(GLOB_RECURSE app_files "${SOURCE_DIR}/apps/*")

set(files "")
foreach(f IN LISTS engine_files)
    if(f MATCHES "/include/")
        list(APPEND files "${f}")
    endif()
endforeach()
list(APPEND files ${app_files})

set(violations "")
set(checked 0)
foreach(f IN LISTS files)
    if(NOT f MATCHES "\\.(h|hh|hpp|hxx|c|cc|cpp|cxx|inl|ipp)$")
        continue()
    endif()
    math(EXPR checked "${checked} + 1")
    file(STRINGS "${f}" hits REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]mujoco/")
    if(hits)
        list(APPEND violations "${f}: ${hits}")
    endif()
endforeach()

if(checked EQUAL 0)
    message(FATAL_ERROR "没有找到任何待检查的文件，SOURCE_DIR 可能有误：${SOURCE_DIR}")
endif()
if(violations)
    string(REPLACE ";" "\n" violations "${violations}")
    message(FATAL_ERROR "公共头或应用中包含了 MuJoCo 头文件：\n${violations}")
endif()
message(STATUS "已检查 ${checked} 个文件，未发现 MuJoCo 头文件包含")
