<!--
  策略控制器夹具（M4-10a，policy.controller）。没有重力、几何体不参与碰撞，观测有解析值：
    base  浮动基座，初始绕 X 轴转 90°：重力方向在机身坐标系中为 (0, −1, 0)；安装点 imu 在机身原点、与机身同向
    j1    转动关节，力矩执行器 m1（gear 1，控制范围 ±3）
    j2    转动关节，力矩执行器 m2（gear 2，控制范围 ±1.5，即力矩 ±3）
    j3    转动关节，只有位置执行器 p3（positionPd 不能用它）
-->
<mujoco model="policy_bench">
  <option timestep="0.002" gravity="0 0 0"/>
  <default>
    <geom contype="0" conaffinity="0" size="0.05" mass="1"/>
  </default>
  <worldbody>
    <body name="base" pos="0 0 1" euler="90 0 0">
      <freejoint name="root"/>
      <geom type="box" size="0.2 0.1 0.05"/>
      <site name="imu"/>
      <body name="leg1" pos="0.2 0 0">
        <joint name="j1" type="hinge" axis="0 1 0"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.2"/>
      </body>
      <body name="leg2" pos="-0.2 0 0">
        <joint name="j2" type="hinge" axis="0 1 0"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.2"/>
      </body>
      <body name="leg3" pos="0 0.1 0">
        <joint name="j3" type="hinge" axis="1 0 0"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.2"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="m1" joint="j1" gear="1" ctrlrange="-3 3"/>
    <motor name="m2" joint="j2" gear="2" ctrlrange="-1.5 1.5"/>
    <position name="p3" joint="j3" kp="10"/>
  </actuator>
</mujoco>
