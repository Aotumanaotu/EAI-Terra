<?xml version="1.0"?>
<!-- Terra M4-08a 测试夹具（由 Terra 编写）：轮子宏 -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="wheel" params="side y effort">
    <link name="${side}_wheel">
      <inertial><mass value="0.2"/><inertia ixx="0.00013" ixy="0" ixz="0" iyy="0.00025" iyz="0" izz="0.00013"/></inertial>
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="0.02"/></geometry><material name="checker"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="0.02"/></geometry></collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel"/><origin xyz="0 ${y} 0"/><axis xyz="0 1 0"/>
      <limit effort="${effort}" velocity="20"/>
    </joint>
  </xacro:macro>
</robot>
