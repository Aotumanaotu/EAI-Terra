{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "TERRA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (GCC + Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (GCC + Ninja)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "render-debug",
      "displayName": "Debug + 渲染 (GCC + Ninja)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "TERRA_BUILD_RENDER": "ON"
      }
    },
    {
      "name": "render-release",
      "displayName": "Release + 渲染 (GCC + Ninja)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "TERRA_BUILD_RENDER": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "render-debug",
      "configurePreset": "render-debug"
    },
    {
      "name": "render-release",
      "configurePreset": "render-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "render-debug",
      "configurePreset": "render-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "render-release",
      "configurePreset": "render-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
