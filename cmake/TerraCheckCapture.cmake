# 用法：cmake -DCAPTURE=<terra_capture> -DSCENE=<场景> -DOUT=<目录> [-DEXPECT_RENDERER=<子串>] -P TerraCheckCapture.cmake
# terra_capture 的确定性与采样次数（M4-04）：同一场景运行两次（60 步），两份输出的文件清单相同、每个文件逐字节相同；
# 夹具 sensor_suite（4 个 IMU 500 Hz、雷达 10 Hz、相机 30 Hz、步长 0.002）：sensors.jsonl 有 4 × 61 行 IMU 与 2 次扫描，
# 相机 4 帧（第 0、17、34、50 步），每帧一张 PNG 与一个 .npy（NumPy 魔数正确）。
foreach(v CAPTURE SCENE OUT)
    if(NOT DEFINED ${v})
        message(FATAL_ERROR "需要 -D${v}")
    endif()
endforeach()
set(extra "")
if(DEFINED EXPECT_RENDERER)
    set(extra --expect-renderer "${EXPECT_RENDERER}")
endif()
foreach(run a b)
    file(REMOVE_RECURSE "${OUT}/${run}")
    execute_process(COMMAND "${CAPTURE}" --scene "${SCENE}" --steps 60 --output "${OUT}/${run}" ${extra}
                    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "第 ${run} 次运行失败（退出码 ${rc}）\n${out}\n${err}")
    endif()
    message(STATUS "第 ${run} 次：${out}")
endforeach()

file(GLOB_RECURSE files_a RELATIVE "${OUT}/a" "${OUT}/a/*")
file(GLOB_RECURSE files_b RELATIVE "${OUT}/b" "${OUT}/b/*")
list(SORT files_a)
list(SORT files_b)
if(NOT files_a STREQUAL files_b)
    message(FATAL_ERROR "两次输出的文件清单不同：\n${files_a}\n${files_b}")
endif()
foreach(f IN LISTS files_a)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUT}/a/${f}" "${OUT}/b/${f}" RESULT_VARIABLE same)
    if(NOT same EQUAL 0)
        message(FATAL_ERROR "两次输出不同：${f}")
    endif()
endforeach()
list(LENGTH files_a count)
message(STATUS "两次输出的 ${count} 个文件逐字节相同")

file(STRINGS "${OUT}/a/sensors.jsonl" lines)
set(imu_lines ${lines})
list(FILTER imu_lines INCLUDE REGEX "\"type\":\"sensor\"")
set(lidar_lines ${lines})
list(FILTER lidar_lines INCLUDE REGEX "\"type\":\"lidar\"")
list(LENGTH imu_lines n_imu)
list(LENGTH lidar_lines n_lidar)
if(NOT n_imu EQUAL 244 OR NOT n_lidar EQUAL 2)
    message(FATAL_ERROR "sensors.jsonl：IMU ${n_imu} 行（应为 244），雷达 ${n_lidar} 次（应为 2）")
endif()
file(STRINGS "${OUT}/a/cameras/cam_eye/frames.jsonl" frames)
list(LENGTH frames n_frames)
file(GLOB pngs "${OUT}/a/cameras/cam_eye/rgb/*.png")
file(GLOB npys "${OUT}/a/cameras/cam_eye/depth/*.npy")
list(LENGTH pngs n_png)
list(LENGTH npys n_npy)
if(NOT n_frames EQUAL 4 OR NOT n_png EQUAL 4 OR NOT n_npy EQUAL 4)
    message(FATAL_ERROR "相机：${n_frames} 帧、${n_png} 张 PNG、${n_npy} 个 .npy（都应为 4）")
endif()
foreach(step 000000 000017 000034 000050)
    if(NOT EXISTS "${OUT}/a/cameras/cam_eye/depth/${step}.npy")
        message(FATAL_ERROR "缺少第 ${step} 步的深度图（相机 30 Hz 的采样步应为 0、17、34、50）")
    endif()
endforeach()
file(READ "${OUT}/a/cameras/cam_eye/depth/000000.npy" magic LIMIT 6 HEX)
if(NOT magic STREQUAL "934e554d5059")
    message(FATAL_ERROR ".npy 魔数不对：${magic}")
endif()
message(STATUS "IMU ${n_imu} 行、雷达 ${n_lidar} 次、相机 ${n_frames} 帧（第 0、17、34、50 步），.npy 格式正确")
