/build/
/out/
compile_commands.json
.cache/

# MuJoCo 源码与构建产物，由 scripts/mujoco/*.sh 生成；版本记录见 third_party/mujoco/mujoco.lock
/third_party/mujoco/downloads/
/third_party/mujoco/src/
/third_party/mujoco/deps/
/third_party/mujoco/build/
/third_party/mujoco/install/

# 渲染依赖源码与构建产物，由 scripts/render/*.sh 生成；版本记录见 third_party/render/render.lock。
# third_party/glad/ 是已提交的生成代码，不在此列。
/third_party/render/downloads/
/third_party/render/src/
/third_party/render/build/
/third_party/render/install/

# HDRI：运行时贴图由 scripts/assets/fetch_hdri.sh 下载（记录见 assets/hdri/hdri.lock）；HDRI/ 是用户保存的 4K EXR 原件
/assets/hdri/*.hdr
/assets/hdri/*.part
/HDRI/
# glTF 测试资产：由 scripts/assets/fetch_models.sh 下载（记录见 assets/models/models.lock）；GLTF/ 是用户保存的原件
/assets/models/*/
/GLTF/
# 参考机器人（M3）：用户下载的 MuJoCo Menagerie 等原件；仓库内的锁定记录与复制由 M3-01 的脚本管理
/ROBOTS/
/assets/robots/*/
# 用户训练产物与策略（M4-10）：检查点、ONNX、TorchScript、训练日志等，体积大且属于用户数据
/others/

# M5-11：3D 激光雷达扫描图案，由 scripts/assets/fetch_lidar_patterns.sh 下载（记录见 assets/sensors/lidar3d_patterns.lock）
/assets/sensors/livox/
