<!--
  场景组合夹具（M2-04）：沿局部 X 轴滑动的小车，带一个电机。不参与碰撞（contype = conaffinity = 0），
  重力垂直于滑轨，因此只有电机能推动它。含一个没有名字的 body 与几何体，用于检查组合后按实例归属；
  bumper 相对车身有偏移，用于检查几何体局部位姿（M2-05）；sensor_zone 的 alpha 为 0，显示时应隐藏（M2-07）。
-->
<mujoco model="cart">
  <option timestep="0.002" integrator="implicitfast"/>
  <worldbody>
    <body name="chassis" pos="0 0 0.1">
      <joint name="slide" type="slide" axis="1 0 0" damping="0.5"/>
      <geom name="hull" type="box" size="0.2 0.1 0.05" mass="1" contype="0" conaffinity="0"/>
      <geom name="bumper" type="box" size="0.02 0.1 0.03" pos="0.22 0 0" mass="0.05" contype="0" conaffinity="0"/>
      <geom name="sensor_zone" type="sphere" size="0.15" pos="0 0 0.3" rgba="1 0 0 0" mass="0.001" contype="0" conaffinity="0"/>
      <body name="mast" pos="0 0 0.1">
        <geom name="pole" type="cylinder" size="0.01 0.1" mass="0.1" contype="0" conaffinity="0"/>
      </body>
      <body pos="0 0 0.25">
        <geom type="sphere" size="0.02" mass="0.05" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="drive" joint="slide" gear="1" ctrllimited="true" ctrlrange="-5 5"/>
  </actuator>
</mujoco>
