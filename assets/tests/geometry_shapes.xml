<!--
  几何体描述夹具（M2-03）：每种形状、带偏移与旋转的几何体、fromto 写法、材质颜色规则、分组与碰撞标志、
  网格几何体、静态几何体（世界上的地面）、子实体上的几何体。数值期望见 tests/physics/test_mujoco_geometry.cpp。
  角度单位为 MJCF 默认的度。
-->
<mujoco model="geometry_shapes">
  <option timestep="0.002"/>
  <asset>
    <material name="red" rgba="0.8 0.1 0.1 1"/>
    <mesh name="tetra" vertex="0 0 0  0.2 0 0  0 0.3 0  0 0 0.4"/>
  </asset>
  <worldbody>
    <geom name="floor" type="plane" size="2 3 0.1" rgba="0.3 0.3 0.3 1"/>
    <body name="base" pos="0 0 1">
      <geom name="ball" type="sphere" size="0.1" pos="0.1 0.2 0.3" group="1"/>
      <geom name="crate" type="box" size="0.1 0.2 0.3" pos="0 0 -0.5" euler="0 0 90" material="red"/>
      <geom name="tinted" type="box" size="0.05 0.05 0.05" pos="0 -0.5 0" material="red" rgba="0 1 0 1"/>
      <geom name="rod" type="capsule" fromto="0 0 0  0 0 0.6" size="0.02"/>
      <geom name="bar" type="capsule" fromto="0 0 0  0.4 0 0" size="0.03"/>
      <geom name="can" type="cylinder" size="0.05 0.1" pos="-0.3 0 0" quat="0.7071068 0.7071068 0 0"/>
      <geom name="egg" type="ellipsoid" size="0.1 0.2 0.3" pos="0 0.5 0" contype="0" conaffinity="0" group="2"/>
      <geom name="tet" type="mesh" mesh="tetra" pos="0.5 0 0"/>
      <body name="child" pos="0 1 0">
        <joint name="spin" type="hinge" axis="0 0 1"/>
        <geom name="child_ball" type="sphere" size="0.05" pos="0 0 0.2"/>
      </body>
    </body>
  </worldbody>
</mujoco>
