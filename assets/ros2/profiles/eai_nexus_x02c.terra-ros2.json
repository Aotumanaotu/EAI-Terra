{
  "format": "terra.ros2",
  "version": 1,
  "name": "EAI-Nexus（X02C）：墙钟时间戳；Mid-360 点云（Livox 格式）与 IMU（g）发到 /driver/lidar/head_center/...；本体 TF 由 Nexus 的 robot_state_publisher、odom → base_link 由 Nexus 的 SLAM 发布；速度指令来自 Nexus 的 /motion/cmd_vel_guarded（TwistStamped）",
  "kind": "generic",
  "time": "wall",
  "jointStatesHz": 50,
  "tfHz": 50,
  "sensors": true,
  "commands": false,
  "services": true,
  "frames": {
    "stripPrefix": "*/",
    "rename": {
      "*/mid360": "lidar_head_center_points_frame",
      "*/mid360_imu": "lidar_head_center_imu_frame"
    }
  },
  "topics": {
    "/joint_states": "/terra/joint_states",
    "/*/mid360/points": "/driver/lidar/head_center/points",
    "/*/mid360_imu/imu": "/driver/lidar/head_center/imu"
  },
  "topicSettings": {
    "/driver/lidar/head_center/points": {"reliability": "best_effort", "depth": 5, "pointLayout": "livox"},
    "/driver/lidar/head_center/imu": {"reliability": "best_effort", "depth": 50, "accelUnit": "g"}
  },
  "tf": {"robot": "none", "sensorMounts": true, "odom": false},
  "cmdVel": [
    {"topic": "/motion/cmd_vel_guarded", "type": "TwistStamped", "priority": 0, "timeout": 0.5}
  ],
  "planarBase": "auto",
  "groundTruth": {"entity": "auto", "topic": "/terra/ground_truth/odom", "frame": "world", "rateHz": 50}
}
