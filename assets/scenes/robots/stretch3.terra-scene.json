{
  "format": "terra.scene",
  "version": 1,
  "name": "Hello Robot Stretch 3 轮式移动操作机器人（Menagerie）",
  "models": [
    {
      "name": "stretch3",
      "mjcf": "../../robots/hello_robot_stretch_3/scene.xml"
    }
  ],
  "view": {
    "camera": {
      "position": [
        1.8,
        1.4,
        1.4
      ],
      "target": [
        0,
        -0.3,
        0.6
      ]
    }
  },
  "initialKeyframe": "stretch3/home",
  "sensors": [
    {"type": "camera", "camera": "stretch3/d435i_camera_rgb", "width": 640, "height": 480, "near": 0.1, "far": 10, "rateHz": 15,
     "displayRotationDeg": 90},
    {"type": "lidar2d", "name": "stretch3/scan", "entity": "stretch3/laser", "angleMinDeg": -180, "angleMaxDeg": 179,
     "samples": 360, "rangeMin": 0.15, "rangeMax": 12, "rateHz": 10}
  ]
}
