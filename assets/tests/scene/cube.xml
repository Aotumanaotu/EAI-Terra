<!-- 场景演示夹具（M2-08）：一个带自由关节的立方体（不含地面，地面由 ground.xml 提供），用于“下落的方块”演示场景。 -->
<mujoco model="cube">
  <option timestep="0.002" integrator="implicitfast"/>
  <worldbody>
    <body name="block" pos="0 0 0">
      <freejoint/>
      <geom name="shell" type="box" size="0.1 0.1 0.1" mass="1" rgba="0.85 0.55 0.2 1"/>
    </body>
  </worldbody>
</mujoco>
